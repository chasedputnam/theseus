# Top-level data directory — contains user data, secrets, and the encryption key.
# Use /data/ (anchored) so it only matches the root-level data/ directory,
# not internal/cookbook/data/ which contains embedded source assets.
/data/

# Built binaries
./theseus
build/

# Environment files
.env
*.env

# macOS
.DS_Store

# Editor
.idea/
.vscode/
*.swp
*.swo
specs/

# Go test cache
*.test
*.out

# Temporary files
*.tmp
*.log

# Theseus configuration
# Copy to .env and customize. Most settings are managed inside the app.

# Server
PORT=7000
DATA_DIR=data
STATIC_DIR=static

# Auth
AUTH_ENABLED=true
LOCALHOST_BYPASS=false

# Database (default: SQLite in DATA_DIR)
# DATABASE_URL=sqlite:///./data/app.db

# LLM
# LLM_HOST=localhost:8000
# OPENAI_API_KEY=

# Search
# SEARXNG_INSTANCE=http://localhost:8080

# ChromaDB (vector memory)
# CHROMADB_HOST=localhost
# CHROMADB_PORT=8100

# Embedding endpoint (optional)
# EMBEDDING_URL=

# Pre-seed admin password (generated on first boot if not set)
# ODYSSEUS_ADMIN_PASSWORD=

# Request timeout (seconds)
# REQUEST_HARD_TIMEOUT=45
